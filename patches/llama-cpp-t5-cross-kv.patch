+llm_graph_input_cross_kv * llm_graph_context::build_inp_cross_kv() const {
+    const size_t dec_n_layer = hparams.dec_n_layer;
+    if (cross->v_embd.empty() || cross->k_cross.size() != dec_n_layer || cross->v_cross.size() != dec_n_layer) {
+        return nullptr;
+    }
+
+    auto inp = std::make_unique<llm_graph_input_cross_kv>(cross);
+    for (size_t il = 0; il < dec_n_layer; ++il) {
+        const int64_t n_k = hparams.n_embd_k_gqa(il);
+        const int64_t n_v = hparams.n_embd_v_gqa(il);
+        ggml_tensor * k = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, n_k, cross->n_enc);
+        ggml_tensor * v = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, n_v, cross->n_enc);
+        ggml_set_input(k);
+        ggml_set_input(v);
+        inp->k.push_back(k);
+        inp->v.push_back(v);
+    }
+
+    auto * result = inp.get();
+    res->add_input(std::move(inp));
+
+    return result;
+}
